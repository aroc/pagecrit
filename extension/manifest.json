{
  "manifest_version": 3,
  "name": "Page Notes",
  "version": "0.2.0",
  "description": "Pin feedback and edit text on a page, then download a Markdown review for your coding agent.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "action": {
    "default_title": "Page Notes \u2014 review this page",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
